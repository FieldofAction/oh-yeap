{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "codex/materials-in-relation-20261008-ccaf5a6e": false,
      "cursor/site-touchup-soon-8b7b": false
    }
  },
  "buildCommand": "if [ \"$BUILD_TARGET\" = \"studio\" ]; then npm run build:studio; else npm run build; fi",
  "rewrites": [
    { "source": "/world-cup-atlas", "destination": "/world-cup-atlas.html" },
    { "source": "/oz-index", "destination": "/oz-index.html" },
    { "source": "/signal-surface", "destination": "/signal-surface.html" },
    { "source": "/start-here", "destination": "/start-here.html" },
    { "source": "/development", "destination": "/development.html" },
    { "source": "/experiments", "destination": "/experiments/index.html" },
    { "source": "/experiments/:slug", "destination": "/experiments/:slug.html" }
  ],
  "headers": [
    {
      "source": "/soulmega/capture/sm-capture-(.*)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/soulmega/capture/config.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/soulmega/capture/lab.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
